# The House Chapter - Environment Variables

# Canonical Production Site URL
PUBLIC_SITE_URL=https://thehousechapter.com

# Newsletter Provider Integration
# Options: 'local' | 'substack' | 'convertkit' | 'custom'
NEWSLETTER_PROVIDER=local
NEWSLETTER_ENDPOINT=/api/newsletter
# CONVERTKIT_API_KEY=your_key_here
# SUBSTACK_PUBLICATION_URL=https://thehousechapter.substack.com

# Analytics Configuration
# Options: 'none' | 'plausible' | 'ga4'
PUBLIC_ANALYTICS_PROVIDER=none
# PUBLIC_PLAUSIBLE_DOMAIN=thehousechapter.com
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Advertising Slots Toggle
PUBLIC_ADS_ENABLED=false
