---
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
  index?: number;
}

const { article, index } = Astro.props;
const { title, description, category, subcategory, heroImage, heroImageAlt, readingTime } = article.data;
---

<article class="group relative flex flex-col bg-ivory border border-brass/40 p-3.5 sm:p-4 transition-all duration-300 hover:shadow-editorial hover:border-brass">
  
  <!-- Outer Corner Brass Accents -->
  <div class="absolute -top-[1px] -left-[1px] w-2 h-2 border-t-2 border-l-2 border-brass pointer-events-none"></div>
  <div class="absolute -top-[1px] -right-[1px] w-2 h-2 border-t-2 border-r-2 border-brass pointer-events-none"></div>
  <div class="absolute -bottom-[1px] -left-[1px] w-2 h-2 border-b-2 border-l-2 border-brass pointer-events-none"></div>
  <div class="absolute -bottom-[1px] -right-[1px] w-2 h-2 border-b-2 border-r-2 border-brass pointer-events-none"></div>

  <!-- Image Plate -->
  <div class="relative aspect-[4/3] overflow-hidden bg-parchment">
    <a
      href={`/${category}/${article.slug}/`}
      class="block w-full h-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-olive"
      tabindex="-1"
      aria-hidden="true"
    >
      <img
        src={heroImage}
        alt={heroImageAlt}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
      />
    </a>
    
    {typeof index === 'number' && (
      <div class="absolute top-2.5 right-2.5 font-serif font-semibold text-[0.6875rem] px-2 py-0.5 bg-ivory/95 text-warmBrown-dark border border-brass/50 shadow-xs">
        Plate {String(index + 1).padStart(2, '0')}
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="flex flex-col flex-grow pt-4">
    
    <div class="flex items-center justify-between text-[0.625rem] uppercase tracking-[0.16em] text-warmBrown font-semibold mb-2">
      <span class="text-olive">{subcategory}</span>
      <span class="text-warmBrown-light">{readingTime}</span>
    </div>

    <h3 class="font-serif text-xl sm:text-2xl font-semibold text-ink-deep leading-snug group-hover:text-olive transition-colors mb-2.5">
      <a href={`/${category}/${article.slug}/`} class="focus-visible:outline-none focus-visible:underline">
        {title}
      </a>
    </h3>

    <p class="text-xs sm:text-sm text-ink-light leading-relaxed line-clamp-2 mt-auto font-normal">
      {description}
    </p>

    <div class="pt-3.5 mt-3 border-t border-editorial-subtle flex items-center justify-between">
      <span class="text-[0.625rem] uppercase tracking-widest text-warmBrown-light font-medium">
        The House Chapter Authority
      </span>
      <a
        href={`/${category}/${article.slug}/`}
        class="text-[0.6875rem] uppercase tracking-[0.14em] text-olive font-semibold group-hover:text-ink-deep transition-colors inline-flex items-center gap-1"
      >
        <span>Examine Blueprint</span>
        <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>
</article>
