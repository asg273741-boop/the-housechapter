---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  compact?: boolean;
}

const {
  eyebrow,
  title,
  description,
  image = '/images/home/entryway.jpg',
  imageAlt = '',
  compact = false,
} = Astro.props;
---

<section class:list={['editorial-masthead', { 'is-compact': compact }]}>
  <div class="editorial-masthead__inner">
    <div class="editorial-masthead__copy">
      <p class="editorial-masthead__eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="editorial-masthead__description">{description}</p>
      <div class="editorial-masthead__rule" aria-hidden="true"><span></span></div>
      <slot />
    </div>
    <figure class="editorial-masthead__visual">
      <img src={image} alt={imageAlt} loading="eager" decoding="async" />
      <div class="editorial-masthead__wash" aria-hidden="true"></div>
      <figcaption>Ideas for a home well lived.</figcaption>
    </figure>
  </div>
</section>

<style>
  .editorial-masthead { background: #f3ece1; border-bottom: 1px solid rgba(35,32,29,.08); }
  .editorial-masthead__inner { display: grid; grid-template-columns: minmax(22rem, 43%) minmax(0, 57%); min-height: 31rem; max-width: 1600px; margin-inline: auto; }
  .editorial-masthead.is-compact .editorial-masthead__inner { min-height: 25rem; }
  .editorial-masthead__copy { position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: center; padding: clamp(3.25rem, 7vw, 7.5rem) clamp(2rem, 5vw, 6.5rem); background: #303929; color: #faf7f2; }
  .editorial-masthead__eyebrow { margin: 0 0 1rem; color: #dfcfc0; font-size: .68rem; font-weight: 700; letter-spacing: .19em; text-transform: uppercase; }
  .editorial-masthead h1 { max-width: 12ch; margin: 0; font-family: var(--font-serif); font-size: clamp(3.25rem, 5.4vw, 6rem); font-weight: 500; letter-spacing: -.035em; line-height: .92; text-wrap: balance; }
  .editorial-masthead.is-compact h1 { font-size: clamp(2.9rem, 4.6vw, 4.8rem); }
  .editorial-masthead__description { max-width: 38rem; margin: 1.55rem 0 0; color: rgba(250,247,242,.85); font-size: clamp(.95rem, 1.3vw, 1.08rem); line-height: 1.75; text-wrap: pretty; }
  .editorial-masthead__rule { display: flex; align-items: center; width: 8.5rem; margin-top: 2rem; border-top: 1px solid rgba(250,247,242,.24); }
  .editorial-masthead__rule span { display: block; width: 2.8rem; border-top: 2px solid #b66348; transform: translateY(-1px); }
  .editorial-masthead__visual { position: relative; min-height: 100%; margin: 0; overflow: hidden; background: #cfc2b2; }
  .editorial-masthead__visual img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s ease; }
  .editorial-masthead:hover .editorial-masthead__visual img { transform: scale(1.015); }
  .editorial-masthead__wash { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(48,57,41,.2), transparent 38%), linear-gradient(0deg, rgba(25,22,20,.24), transparent 42%); }
  .editorial-masthead figcaption { position: absolute; right: 2rem; bottom: 1.5rem; color: rgba(255,252,247,.9); font-family: var(--font-serif); font-size: 1.05rem; font-style: italic; text-shadow: 0 1px 12px rgba(25,22,20,.55); }
  :global(.editorial-masthead__actions) { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.5rem; }
  :global(.editorial-masthead__action) { display: inline-flex; min-height: 2.7rem; align-items: center; justify-content: center; padding: .7rem 1.15rem; border: 1px solid rgba(250,247,242,.3); color: #faf7f2; font-size: .67rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; transition: background .2s ease, color .2s ease; }
  :global(.editorial-masthead__action:hover) { background: #faf7f2; color: #303929; }
  @media (max-width: 900px) {
    .editorial-masthead__inner { grid-template-columns: 1fr; min-height: 0; }
    .editorial-masthead__copy { min-height: 25rem; padding: 4rem max(1.25rem, 6vw); }
    .editorial-masthead__visual { min-height: 20rem; }
    .editorial-masthead h1 { max-width: 14ch; font-size: clamp(3rem, 11vw, 5rem); }
  }
  @media (max-width: 560px) {
    .editorial-masthead__copy { min-height: 22rem; padding-block: 3.25rem; }
    .editorial-masthead__visual { min-height: 15rem; }
    .editorial-masthead__description { line-height: 1.6; }
    .editorial-masthead figcaption { right: 1.1rem; bottom: 1rem; }
  }
</style>
