---
interface Props {
  title?: string;
}

const { title = 'Common Mistake to Avoid' } = Astro.props;
---

<div class="my-8 p-5 sm:p-6 bg-[#FAF5F2] border-l-4 border-warmBrown-light rounded-none shadow-sm not-prose">
  <div class="flex items-start gap-3.5">
    <div class="p-1.5 rounded-full bg-warmBrown/10 text-warmBrown shrink-0 mt-0.5" aria-hidden="true">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
    </div>
    <div class="space-y-1.5 flex-grow">
      <h4 class="font-serif font-semibold text-base text-ink-deep tracking-wide">
        {title}
      </h4>
      <div class="text-sm text-ink-light leading-relaxed font-normal">
        <slot />
      </div>
    </div>
  </div>
</div>
