---
interface Props {
  url: string;
  title: string;
  media?: string;
  description?: string;
}

const { url, title, media = '', description = '' } = Astro.props;

const pinterestUrl = `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}&media=${encodeURIComponent(media)}&description=${encodeURIComponent(`${title} — ${description}`)}`;
const xUrl = `https://x.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
const fbUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
---

<div class="my-10 py-5 px-4 sm:px-6 bg-parchment/60 border border-editorial rounded-sm flex flex-wrap items-center justify-between gap-4 not-prose shadow-xs">
  
  <!-- Left Side: Interactive Like Button -->
  <div class="flex items-center gap-3">
    <button
      type="button"
      id="like-article-btn"
      class="group inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-editorial bg-ivory hover:border-terracotta/60 hover:bg-terracotta/5 transition-all duration-200 text-xs font-medium text-ink-deep"
      aria-label="Like this chapter"
      data-article-url={url}
    >
      <svg id="like-icon" class="w-4 h-4 text-warmBrown-light group-hover:text-terracotta transition-colors duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
      <span id="like-count" class="font-serif font-semibold text-xs tracking-wide">48</span>
      <span class="text-[0.6875rem] text-warmBrown-light group-hover:text-terracotta transition-colors">Likes</span>
    </button>
  </div>

  <!-- Right Side: Share & Copy Options -->
  <div class="flex flex-wrap items-center gap-2">
    <!-- Pinterest Pin Button -->
    <a
      href={pinterestUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#E60023] hover:bg-[#b8001c] text-white text-xs font-semibold rounded-sm transition-all shadow-xs hover:shadow-sm"
      aria-label="Save this idea on Pinterest"
    >
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.291 1.199-.332 1.365-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
      </svg>
      <span>Pin</span>
    </a>

    <!-- Facebook Share -->
    <a
      href={fbUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center w-8 h-8 rounded-sm bg-ivory hover:bg-parchment text-ink-deep border border-editorial transition-colors"
      aria-label="Share on Facebook"
      title="Share on Facebook"
    >
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
      </svg>
    </a>

    <!-- X / Twitter Share -->
    <a
      href={xUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center w-8 h-8 rounded-sm bg-ivory hover:bg-parchment text-ink-deep border border-editorial transition-colors"
      aria-label="Share on X"
      title="Share on X"
    >
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
    </a>

    <!-- Native Web Share (if supported) -->
    <button
      type="button"
      id="native-share-btn"
      class="hidden sm:hidden items-center gap-1.5 px-3 py-1.5 bg-ivory hover:bg-parchment text-ink-deep text-xs font-medium border border-editorial rounded-sm transition-colors"
      aria-label="Share this chapter"
    >
      <svg class="w-3.5 h-3.5 text-olive" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
      </svg>
      <span>Share</span>
    </button>

    <!-- Copy Link Button -->
    <button
      type="button"
      id="copy-link-btn"
      class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-ivory hover:bg-parchment text-ink-deep text-xs font-medium border border-editorial rounded-sm transition-colors"
      aria-label="Copy link to clipboard"
    >
      <svg id="copy-icon" class="w-3.5 h-3.5 text-olive" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      <span id="copy-label">Copy Link</span>
    </button>
  </div>
</div>

<script>
  // Like Button Functionality with Persistent localStorage
  const likeBtn = document.getElementById('like-article-btn');
  if (likeBtn) {
    const url = likeBtn.getAttribute('data-article-url') || window.location.pathname;
    const storageKey = `thc_liked_${url}`;
    const countEl = document.getElementById('like-count');
    const iconEl = document.getElementById('like-icon');

    // Base mock like count for realism
    let baseCount = 54;
    const isLiked = localStorage.getItem(storageKey) === 'true';

    if (isLiked) {
      baseCount += 1;
      setLikedState(true);
    }
    if (countEl) countEl.textContent = String(baseCount);

    likeBtn.addEventListener('click', () => {
      const currentlyLiked = localStorage.getItem(storageKey) === 'true';
      if (!currentlyLiked) {
        localStorage.setItem(storageKey, 'true');
        baseCount += 1;
        setLikedState(true);
      } else {
        localStorage.removeItem(storageKey);
        baseCount -= 1;
        setLikedState(false);
      }
      if (countEl) countEl.textContent = String(baseCount);
    });

    function setLikedState(active: boolean) {
      if (!iconEl) return;
      if (active) {
        iconEl.setAttribute('fill', '#B66348');
        iconEl.setAttribute('stroke', '#B66348');
        likeBtn?.classList.add('border-terracotta', 'bg-terracotta/10');
      } else {
        iconEl.setAttribute('fill', 'none');
        iconEl.setAttribute('stroke', 'currentColor');
        likeBtn?.classList.remove('border-terracotta', 'bg-terracotta/10');
      }
    }
  }

  // Copy Link Button Functionality
  const copyBtn = document.getElementById('copy-link-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const label = document.getElementById('copy-label');
        if (label) {
          const original = label.textContent;
          label.textContent = 'Copied!';
          copyBtn.classList.add('bg-olive/10', 'border-olive');
          setTimeout(() => {
            label.textContent = original;
            copyBtn.classList.remove('bg-olive/10', 'border-olive');
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy link', err);
      }
    });
  }

  // Native Web Share API (mobile devices)
  const shareBtn = document.getElementById('native-share-btn');
  if (shareBtn && typeof navigator.share === 'function') {
    shareBtn.classList.remove('hidden');
    shareBtn.classList.add('inline-flex');
    shareBtn.addEventListener('click', async () => {
      try {
        await navigator.share({
          title: document.title,
          url: window.location.href,
        });
      } catch {
        // user cancelled or share failed
      }
    });
  }
</script>
