---
interface Props {
  title?: string;
}

const { title = 'Designer Practical Tip' } = Astro.props;
---

<div class="my-8 p-5 sm:p-6 bg-parchment border-l-4 border-olive rounded-none shadow-sm not-prose">
  <div class="flex items-start gap-3.5">
    <div class="p-1.5 rounded-full bg-olive/10 text-olive shrink-0 mt-0.5" aria-hidden="true">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <div class="space-y-1.5 flex-grow">
      <h4 class="font-serif font-semibold text-base text-ink-deep tracking-wide">
        {title}
      </h4>
      <div class="text-sm text-ink-light leading-relaxed font-normal">
        <slot />
      </div>
    </div>
  </div>
</div>
