---
import Logo from '../ui/Logo.astro';
import { siteConfig } from '../../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="bg-ink-deep text-parchment border-t border-ink-light mt-24">
  <div class="max-w-wide mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8">
      
      <!-- Brand & Mission Column (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Inverted Logo for Dark Footer -->
        <a href="/" class="inline-flex items-center gap-3.5 group">
          <svg class="w-9 h-9 shrink-0" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <path d="M12 56V26C12 14.9543 20.9543 6 32 6C43.0457 6 52 14.9543 52 26V56" stroke="#DECFC0" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M18 56V27C18 19.268 24.268 13 32 13C39.732 13 46 19.268 46 27V56" stroke="#73876E" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M6 56H58" stroke="#DECFC0" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M22 42C24 36 29 33 32 30" stroke="#C77358" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M22 38C19 35 21 31 25 33C27 34 26 37 22 38Z" fill="#9BB096"/>
            <path d="M32 30C35 27 38 23 40 18" stroke="#9BB096" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M35 27C38 25 41 27 39 30C37 32 35 30 35 27Z" fill="#9BB096"/>
            <circle cx="32" cy="18" r="3" fill="#E0BE78"/>
          </svg>
          <div class="flex flex-col text-left">
            <span class="font-serif tracking-[0.16em] text-lg font-semibold text-ivory leading-none uppercase">
              The House Chapter
            </span>
            <span class="font-serif italic text-xs text-clay-light tracking-wide mt-1">
              Ideas for a home well lived.
            </span>
          </div>
        </a>

        <p class="text-sm leading-relaxed text-parchment/80 max-w-md font-normal">
          {siteConfig.description}
        </p>

        <div class="pt-2">
          <span class="text-xs tracking-widest uppercase font-semibold text-clay-light block mb-2.5">
            Follow Our Pinterest Boards
          </span>
          <div class="flex items-center space-x-3">
            <a
              href={siteConfig.socialLinks.pinterest}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-medium px-4 py-2.5 rounded-none bg-clay hover:bg-clay-dark text-ivory transition-colors shadow-xs"
              aria-label="Pinterest"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.291 1.199-.332 1.365-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
              </svg>
              <span>Pinterest Discovery</span>
            </a>
            <a
              href="/rss.xml"
              class="inline-flex items-center gap-1.5 text-xs font-medium px-3.5 py-2.5 bg-ink-light hover:bg-ink-lighter text-parchment border border-ink-lighter transition-colors"
              aria-label="RSS Feed"
            >
              <svg class="w-3.5 h-3.5 text-clay-light" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18h.01M4 4a16 16 0 0116 16M4 11a9 9 0 019 9" />
              </svg>
              <span>RSS Feed</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Categories Column (4 cols) -->
      <div class="lg:col-span-4">
        <h3 class="text-xs font-semibold tracking-[0.16em] uppercase text-ivory mb-4 pb-1 border-b border-ink-light">
          The Editorial Chapters
        </h3>
        <div class="grid grid-cols-2 gap-x-6 gap-y-2.5">
          {siteConfig.navigation.footerExplore.map((item) => (
            <a
              href={item.href}
              class="text-xs text-parchment/70 hover:text-ivory hover:underline underline-offset-4 transition-colors flex items-center gap-1.5"
            >
              <span>{item.label}</span>
              {item.isSpecialty && (
                <span class="w-1.5 h-1.5 rounded-full bg-clay shrink-0" title="Specialty Pillar" />
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Editorial & Utility Column (3 cols) -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-xs font-semibold tracking-[0.16em] uppercase text-ivory mb-4 pb-1 border-b border-ink-light">
          Publication
        </h3>
        <ul class="space-y-2.5">
          {siteConfig.navigation.footerCompany.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-xs text-parchment/70 hover:text-ivory hover:underline underline-offset-4 transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        <div class="pt-6 border-t border-ink-light">
          <p class="text-[0.6875rem] text-parchment/60 leading-relaxed font-serif italic">
            Broad brand. Focused editorial authority in entryways, hallways, and functional home order.
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Legal Row -->
    <div class="mt-16 pt-8 border-t border-ink-light flex flex-col sm:flex-row items-center justify-between text-[0.75rem] text-parchment/60 gap-4">
      <p>
        &copy; {currentYear} {siteConfig.siteName}. Ideas for a home well lived.
      </p>
      <div class="flex items-center space-x-6">
        <a href="/about/" class="hover:text-ivory transition-colors">Editorial Standards</a>
        <a href="/contact/" class="hover:text-ivory transition-colors">Contact</a>
        <a href="/privacy/" class="hover:text-ivory transition-colors">Privacy</a>
        <a href="/terms/" class="hover:text-ivory transition-colors">Terms</a>
      </div>
    </div>
  </div>
</footer>
