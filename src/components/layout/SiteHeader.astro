---
import Logo from '../ui/Logo.astro';
import { siteConfig } from '../../config/site';

const currentPath = Astro.url.pathname;
const desktopNavigation = [
  { label: 'Decor', href: '/home-decor/' },
  { label: 'Rooms', href: '/rooms/' },
  { label: 'Styling', href: '/furniture-styling/' },
  { label: 'Organization', href: '/organization-storage/' },
  { label: 'Small Spaces', href: '/small-space-living/' },
  { label: 'Apartments', href: '/apartments/' },
  { label: 'Entryways', href: '/entryways-hallways/', specialty: true },
];

const mobileNavigation = [
  { label: 'Home', href: '/' },
  ...desktopNavigation,
];
---

<header class="site-header sticky top-0 z-40 w-full border-b border-editorial bg-ivory/95 backdrop-blur-md">
  <!-- Desktop header -->
  <div class="hidden xl:grid header-shell h-[4.5rem] grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-5 xl:gap-7">
    <Logo variant="compact" />

    <nav class="flex min-w-0 items-center justify-center gap-4 xl:gap-6 2xl:gap-8" aria-label="Primary navigation">
      {desktopNavigation.map((item) => {
        const isActive = currentPath === item.href || currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            class={`group relative whitespace-nowrap py-2 text-[0.67rem] font-semibold uppercase tracking-[0.105em] transition-colors xl:text-[0.7rem] ${
              isActive ? 'text-ink-deep' : 'text-ink-lighter hover:text-ink-deep'
            }`}
          >
            {item.label}
            {item.specialty && <span class="ml-1 inline-block h-1.5 w-1.5 rounded-full bg-clay align-middle" />}
            <span class={`absolute inset-x-0 bottom-0 h-px origin-left bg-olive transition-transform duration-300 ${isActive ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100'}`} />
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-search-trigger
        class="header-action"
        aria-label="Search articles"
        title="Search articles (Ctrl+K)"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.2-5.2m0 0A7.5 7.5 0 105.2 5.2a7.5 7.5 0 0010.6 10.6z" />
        </svg>
        <span class="hidden 2xl:inline">Search</span>
      </button>
      <a
        href={siteConfig.socialLinks.pinterest}
        target="_blank"
        rel="noopener noreferrer"
        class="header-pinterest"
        aria-label="Visit The House Chapter on Pinterest"
        title="Pinterest"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.08 3.16 9.43 7.63 11.17-.11-.95-.2-2.41.04-3.44.22-.94 1.41-5.97 1.41-5.97s-.36-.72-.36-1.78c0-1.67.97-2.91 2.17-2.91 1.02 0 1.52.77 1.52 1.69 0 1.03-.66 2.57-.99 4-.28 1.19.6 2.17 1.78 2.17 2.13 0 3.77-2.25 3.77-5.5 0-2.87-2.06-4.88-5.01-4.88-3.41 0-5.42 2.56-5.42 5.21 0 1.03.4 2.14.89 2.74.1.12.11.22.08.35-.09.38-.29 1.2-.33 1.37-.05.22-.17.27-.4.16-1.5-.7-2.44-2.89-2.44-4.65 0-3.79 2.75-7.26 7.93-7.26 4.16 0 7.4 2.97 7.4 6.93 0 4.14-2.61 7.46-6.23 7.46-1.22 0-2.36-.63-2.75-1.38l-.75 2.85c-.27 1.04-1 2.35-1.49 3.15C9.57 23.81 10.76 24 12 24c6.63 0 12-5.37 12-12S18.63 0 12 0z" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Mobile header -->
  <div class="header-shell flex h-16 items-center justify-between gap-3 xl:hidden">
    <Logo variant="compact" />
    <div class="flex shrink-0 items-center gap-1.5">
      <button type="button" data-search-trigger class="mobile-action" aria-label="Search articles">
        <svg class="h-[1.15rem] w-[1.15rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.2-5.2m0 0A7.5 7.5 0 105.2 5.2a7.5 7.5 0 0010.6 10.6z" />
        </svg>
      </button>
      <button
        type="button"
        id="mobile-menu-btn"
        class="mobile-action"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Open navigation menu"
      >
        <svg class="icon-menu h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path stroke-linecap="round" d="M5 7h14M5 12h14M5 17h14" />
        </svg>
        <svg class="icon-close hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <button id="mobile-nav-scrim" class="mobile-nav-scrim hidden xl:hidden" aria-label="Close navigation menu"></button>

  <div id="mobile-nav-drawer" class="mobile-drawer hidden xl:hidden" aria-label="Mobile navigation">
    <div class="header-shell py-6">
      <button type="button" data-search-trigger data-mobile-search class="mobile-search-row">
        <svg class="h-4 w-4 text-olive" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.2-5.2m0 0A7.5 7.5 0 105.2 5.2a7.5 7.5 0 0010.6 10.6z" />
        </svg>
        <span>Search ideas, rooms and guides</span>
        <span aria-hidden="true">→</span>
      </button>

      <div class="mt-6">
        <p class="menu-kicker">Explore the house</p>
        <nav class="mt-2 grid grid-cols-2 gap-x-5" aria-label="Mobile primary navigation">
          {mobileNavigation.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <a href={item.href} class={`mobile-nav-link ${isActive ? 'is-active' : ''}`}>
                <span>{item.label}</span>
                {'specialty' in item && item.specialty && <span class="h-1.5 w-1.5 rounded-full bg-clay" />}
              </a>
            );
          })}
        </nav>
      </div>

      <div class="mt-6 border-t border-editorial pt-5">
        <p class="menu-kicker">More inspiration</p>
        <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2.5">
          {siteConfig.navigation.secondary.map((item) => (
            <a href={item.href} class="text-xs text-ink-light transition-colors hover:text-clay">{item.label}</a>
          ))}
        </div>
      </div>

      <div class="mt-6 flex items-center justify-between border-t border-editorial pt-5 text-xs">
        <div class="flex gap-5 text-ink-lighter">
          <a href="/about/" class="hover:text-ink-deep">About</a>
          <a href="/contact/" class="hover:text-ink-deep">Contact</a>
        </div>
        <a href={siteConfig.socialLinks.pinterest} target="_blank" rel="noopener noreferrer" class="font-semibold text-clay hover:text-clay-dark">Pinterest ↗</a>
      </div>
    </div>
  </div>
</header>

<style>
  .header-shell { width: min(100% - 2rem, 1360px); margin-inline: auto; }
  .header-action, .header-pinterest, .mobile-action { display: inline-flex; align-items: center; justify-content: center; transition: background-color .2s ease, color .2s ease, border-color .2s ease; }
  .header-action { min-width: 2.5rem; height: 2.5rem; gap: .45rem; padding-inline: .7rem; border: 1px solid rgba(35,32,29,.1); background: #f4ede3; color: #3d3732; font-size: .65rem; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; }
  .header-action:hover { background: #eae1d3; color: #191614; }
  .header-pinterest { width: 2.5rem; height: 2.5rem; background: #b66348; color: #fffaf2; }
  .header-pinterest:hover { background: #8e4630; }
  .mobile-action { width: 2.4rem; height: 2.4rem; border: 1px solid rgba(35,32,29,.1); color: #29251f; }
  .mobile-action:hover { background: #f3ece1; }
  .mobile-nav-scrim { position: absolute; inset-inline: 0; top: 100%; z-index: 1; height: calc(100vh - 4rem); cursor: default; background: rgba(35,32,29,.28); backdrop-filter: blur(2px); }
  .mobile-drawer { position: absolute; inset-inline: 0; top: 100%; z-index: 2; max-height: calc(100vh - 4rem); overflow-y: auto; border-top: 1px solid rgba(35,32,29,.08); background: #faf7f2; box-shadow: 0 24px 48px rgba(35,32,29,.14); }
  .mobile-search-row { display: grid; width: 100%; grid-template-columns: auto 1fr auto; align-items: center; gap: .75rem; padding: .9rem 1rem; border: 1px solid rgba(35,32,29,.1); background: #f3ece1; color: #544e48; font-size: .75rem; text-align: left; }
  .menu-kicker { margin: 0; color: #8a6e5e; font-size: .62rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .mobile-nav-link { display: flex; min-height: 2.9rem; align-items: center; justify-content: space-between; gap: .5rem; border-bottom: 1px solid rgba(35,32,29,.08); color: #26221e; font-family: var(--font-serif); font-size: 1.08rem; font-weight: 600; transition: color .2s ease, padding-left .2s ease; }
  .mobile-nav-link:hover, .mobile-nav-link.is-active { color: #8e4630; padding-left: .2rem; }
  @media (min-width: 1280px) { .header-shell { width: min(100% - 3rem, 1360px); } }
  @media (max-width: 370px) { .header-shell { width: min(100% - 1.25rem, 1360px); } }
</style>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-nav-drawer');
  const scrim = document.getElementById('mobile-nav-scrim');
  const iconMenu = menuBtn?.querySelector('.icon-menu');
  const iconClose = menuBtn?.querySelector('.icon-close');

  function setMobileMenu(open: boolean) {
    if (!menuBtn || !drawer || !scrim || !iconMenu || !iconClose) return;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
    drawer.classList.toggle('hidden', !open);
    scrim.classList.toggle('hidden', !open);
    iconMenu.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
  }

  menuBtn?.addEventListener('click', () => setMobileMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
  scrim?.addEventListener('click', () => setMobileMenu(false));
  drawer?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMobileMenu(false)));
  drawer?.querySelector('[data-mobile-search]')?.addEventListener('click', () => setMobileMenu(false));

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') setMobileMenu(false);
  });
</script>
