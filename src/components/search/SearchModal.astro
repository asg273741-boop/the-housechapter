---
---

<div
  id="search-dialog"
  class="fixed inset-0 z-50 hidden bg-ink-deep/60 backdrop-blur-sm transition-opacity p-4 sm:p-6 md:p-20 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-dialog-title"
>
  <div class="relative w-full max-w-2xl mx-auto bg-ivory border border-editorial shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
    
    <!-- Top Search Header -->
    <div class="p-4 sm:p-5 border-b border-editorial flex items-center gap-3 bg-parchment/40">
      <svg class="w-5 h-5 text-olive shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
      </svg>
      <input
        type="search"
        id="search-input"
        placeholder="Search ideas, rooms, entryways, storage..."
        class="w-full bg-transparent text-ink placeholder:text-warmBrown-light text-base md:text-lg outline-none font-sans"
        autocomplete="off"
        spellcheck="false"
      />
      <button
        type="button"
        id="search-close-btn"
        class="p-1.5 text-warmBrown hover:text-ink-deep rounded hover:bg-parchment transition-colors"
        aria-label="Close search"
      >
        <span class="text-xs uppercase tracking-wider font-semibold mr-1 hidden sm:inline">ESC</span>
        <svg class="w-5 h-5 inline-block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Quick Navigation / Category Shortcuts -->
    <div class="px-5 py-3 bg-ivory border-b border-editorial-subtle flex items-center gap-2 overflow-x-auto text-xs">
      <span class="text-warmBrown-light font-medium shrink-0">Popular:</span>
      <button type="button" class="quick-filter px-2 py-0.5 rounded bg-parchment hover:bg-parchment-hover text-ink-light transition-colors" data-term="entryway">
        Entryways
      </button>
      <button type="button" class="quick-filter px-2 py-0.5 rounded bg-parchment hover:bg-parchment-hover text-ink-light transition-colors" data-term="storage">
        Storage
      </button>
      <button type="button" class="quick-filter px-2 py-0.5 rounded bg-parchment hover:bg-parchment-hover text-ink-light transition-colors" data-term="small space">
        Small Spaces
      </button>
      <button type="button" class="quick-filter px-2 py-0.5 rounded bg-parchment hover:bg-parchment-hover text-ink-light transition-colors" data-term="hallway">
        Hallways
      </button>
    </div>

    <!-- Results Container -->
    <div id="search-results-list" class="max-h-[60vh] overflow-y-auto p-4 sm:p-5 space-y-3">
      <div id="search-placeholder-msg" class="text-center py-10 text-sm text-warmBrown-light">
        Type to search across all chapters, rooms, and decorating guides.
      </div>
      <div id="search-empty-msg" class="hidden text-center py-10">
        <p class="font-serif text-lg text-ink-deep mb-1">No chapters found</p>
        <p class="text-xs text-warmBrown-light">Try searching for "entryway", "bedroom", or "storage".</p>
      </div>
    </div>

  </div>
</div>

<script>
  interface SearchItem {
    title: string;
    description: string;
    slug: string;
    category: string;
    subcategory: string;
    readingTime: string;
    heroImage: string;
    specialty: boolean;
  }

  let searchIndex: SearchItem[] | null = null;
  const dialog = document.getElementById('search-dialog');
  const triggerBtn = document.getElementById('search-trigger-btn');
  const closeBtn = document.getElementById('search-close-btn');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const resultsContainer = document.getElementById('search-results-list');
  const placeholderMsg = document.getElementById('search-placeholder-msg');
  const emptyMsg = document.getElementById('search-empty-msg');
  const quickFilters = document.querySelectorAll('.quick-filter');

  async function loadSearchIndex() {
    if (searchIndex) return searchIndex;
    try {
      const res = await fetch('/api/search-index.json');
      searchIndex = await res.json();
      return searchIndex;
    } catch (e) {
      console.error('Failed to load search index', e);
      return [];
    }
  }

  function openSearch() {
    if (!dialog || !searchInput) return;
    dialog.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    searchInput.focus();
    loadSearchIndex();
  }

  function closeSearch() {
    if (!dialog || !searchInput) return;
    dialog.classList.add('hidden');
    document.body.style.overflow = '';
    searchInput.value = '';
    renderResults([]);
  }

  function renderResults(results: SearchItem[]) {
    if (!resultsContainer || !placeholderMsg || !emptyMsg) return;

    // Remove old results
    const oldItems = resultsContainer.querySelectorAll('.search-result-card');
    oldItems.forEach((el) => el.remove());

    if (!searchInput?.value.trim()) {
      placeholderMsg.classList.remove('hidden');
      emptyMsg.classList.add('hidden');
      return;
    }

    placeholderMsg.classList.add('hidden');

    if (results.length === 0) {
      emptyMsg.classList.remove('hidden');
      return;
    }

    emptyMsg.classList.add('hidden');

    results.forEach((item) => {
      const card = document.createElement('a');
      card.href = `/${item.slug}/`;
      card.className = 'search-result-card flex items-center gap-4 p-3 bg-ivory hover:bg-parchment border border-editorial transition-colors group block';
      card.innerHTML = `
        <div class="w-16 h-16 sm:w-20 sm:h-20 shrink-0 bg-parchment overflow-hidden">
          <img src="${item.heroImage}" alt="${item.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
        </div>
        <div class="flex-grow min-w-0">
          <div class="flex items-center gap-2 text-[0.6875rem] uppercase tracking-wider text-warmBrown-light mb-1">
            <span class="text-olive font-semibold">${item.subcategory || item.category}</span>
            <span>&bull;</span>
            <span>${item.readingTime}</span>
          </div>
          <h4 class="font-serif text-sm sm:text-base font-semibold text-ink-deep group-hover:text-olive transition-colors truncate">
            ${item.title}
          </h4>
          <p class="text-xs text-ink-light truncate mt-0.5">
            ${item.description}
          </p>
        </div>
      `;
      resultsContainer.appendChild(card);
    });
  }

  function performSearch(query: string) {
    if (!searchIndex) return;
    const q = query.toLowerCase().trim();
    if (!q) {
      renderResults([]);
      return;
    }

    const filtered = searchIndex.filter((item) => {
      return (
        item.title.toLowerCase().includes(q) ||
        item.description.toLowerCase().includes(q) ||
        item.subcategory.toLowerCase().includes(q) ||
        item.category.toLowerCase().includes(q)
      );
    });

    renderResults(filtered);
  }

  // Event Listeners
  triggerBtn?.addEventListener('click', openSearch);
  closeBtn?.addEventListener('click', closeSearch);

  // Close on backdrop click
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) closeSearch();
  });

  // Keyboard shortcut Ctrl+K or Cmd+K or ESC
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      if (dialog?.classList.contains('hidden')) {
        openSearch();
      } else {
        closeSearch();
      }
    }
    if (e.key === 'Escape' && !dialog?.classList.contains('hidden')) {
      closeSearch();
    }
  });

  searchInput?.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value;
    performSearch(val);
  });

  quickFilters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const term = btn.getAttribute('data-term') || '';
      if (searchInput) {
        searchInput.value = term;
        performSearch(term);
      }
    });
  });
</script>
