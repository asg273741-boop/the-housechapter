---
import BaseLayout from './BaseLayout.astro';
import EditorialMasthead from '../components/editorial/EditorialMasthead.astro';
import SocialShare from '../components/editorial/SocialShare.astro';
import FaqAccordion from '../components/editorial/FaqAccordion.astro';
import TipBox from '../components/editorial/TipBox.astro';
import MistakeBox from '../components/editorial/MistakeBox.astro';
import NewsletterSignup from '../components/editorial/NewsletterSignup.astro';
import AdSlot from '../components/editorial/AdSlot.astro';
import ArticleCard from '../components/cards/ArticleCard.astro';
import { siteConfig } from '../config/site';
import { generateArticleSchema, generateBreadcrumbSchema, generateFaqSchema } from '../utils/schema';
import { getRelatedArticles } from '../utils/relatedArticles';
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
  allArticles: CollectionEntry<'articles'>[];
}

const { article, allArticles } = Astro.props;
const {
  title,
  description,
  category,
  subcategory,
  author,
  authorRole,
  publishedAt,
  updatedAt,
  heroImage,
  heroImageAlt,
  readingTime,
  faq,
  practicalTips,
  mistakesToAvoid,
  socialImage,
  specialty,
} = article.data;

const currentUrl = `${siteConfig.siteUrl}/${article.slug}/`;
const categoryInfo = siteConfig.categories[category] || {
  name: category.replace('-', ' '),
  slug: category,
};

// Breadcrumbs
const breadcrumbs = [
  { label: categoryInfo.name, href: `/${category}/` },
  { label: subcategory, href: `/${category}/` },
  { label: title },
];

// Structured data
const articleSchema = generateArticleSchema({
  title,
  description,
  url: currentUrl,
  heroImage: socialImage || heroImage,
  publishedAt,
  updatedAt,
  authorName: author,
});

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs.map((b) => ({
  name: b.label,
  item: b.href || currentUrl,
})));

const faqSchema = generateFaqSchema(faq);

const structuredData = [
  articleSchema,
  breadcrumbSchema,
  ...(faqSchema ? [faqSchema] : []),
];

// Related Articles Engine
const relatedArticles = getRelatedArticles(article, allArticles, 4);

// Format date
const formattedPublishDate = new Date(publishedAt).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<BaseLayout
  title={title}
  description={description}
  image={socialImage || heroImage}
  imageAlt={heroImageAlt}
  type="article"
  publishedTime={publishedAt}
  modifiedTime={updatedAt || publishedAt}
  author={author}
  structuredData={structuredData}
>
  <EditorialMasthead
    eyebrow={`${categoryInfo.name} • ${subcategory}${specialty ? ' • Signature story' : ''}`}
    title={title}
    description={description}
    image={heroImage}
    imageAlt={heroImageAlt}
  >
    <div class="article-masthead-meta">
      <span class="article-masthead-avatar">{author.charAt(0)}</span>
      <span><strong>{author}</strong><small>{authorRole}</small></span>
      <span class="article-masthead-date"><time datetime={publishedAt}>{formattedPublishDate}</time> · {readingTime}</span>
    </div>
  </EditorialMasthead>

  <article class="max-w-wide mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-14">

    <!-- Ad Slot (After Hero / Intro) -->
    <AdSlot slotId="after-intro" format="banner" />

    <!-- Main Content Body -->
    <div class="max-w-reading mx-auto">
      
      <!-- At a Glance / Blueprint Box -->
      <div class="my-8 p-6 bg-parchment/60 border border-editorial not-prose">
        <div class="flex items-center gap-2 text-xs uppercase tracking-[0.16em] text-olive font-semibold mb-3">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Curator's Editorial Summary</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs text-ink-light pt-2 border-t border-editorial-subtle">
          <div>
            <span class="font-semibold text-ink-deep block mb-0.5">Spatial Focus:</span>
            <span>{subcategory}</span>
          </div>
          <div>
            <span class="font-semibold text-ink-deep block mb-0.5">Key Materials:</span>
            <span>White Oak, Brass, Linen</span>
          </div>
          <div>
            <span class="font-semibold text-ink-deep block mb-0.5">Time to Implement:</span>
            <span>Weekend Refresh</span>
          </div>
        </div>
      </div>

      <!-- Main Prose with Editorial Dropcap -->
      <div class="prose prose-lg prose-ink mx-auto focus:outline-none editorial-dropcap">
        <slot />
      </div>

      <!-- Practical Tips Box (If provided in frontmatter) -->
      {practicalTips && practicalTips.length > 0 && (
        <TipBox title="Editorial Guidelines: Quick Practical Rules">
          <ul class="list-disc pl-5 space-y-2 mt-2">
            {practicalTips.map((tip) => (
              <li>{tip}</li>
            ))}
          </ul>
        </TipBox>
      )}

      <!-- Mistakes Box (If provided in frontmatter) -->
      {mistakesToAvoid && mistakesToAvoid.length > 0 && (
        <MistakeBox title="What Often Goes Wrong (And How to Fix It)">
          <ul class="list-disc pl-5 space-y-2 mt-2">
            {mistakesToAvoid.map((mistake) => (
              <li>{mistake}</li>
            ))}
          </ul>
        </MistakeBox>
      )}

      <!-- Social Share Bar (Pinterest Pin Button & Copy Link) -->
      <SocialShare
        url={currentUrl}
        title={title}
        media={socialImage || heroImage}
        description={description}
      />

      <!-- FAQ Section (Schema-ready) -->
      {faq && faq.length > 0 && (
        <FaqAccordion items={faq} />
      )}

      <!-- Author Bio Box -->
      <div class="my-12 p-6 sm:p-8 bg-parchment/60 border border-editorial flex flex-col sm:flex-row items-center sm:items-start gap-5 not-prose">
        <div class="w-14 h-14 rounded-full bg-ivory border border-brass/40 flex items-center justify-center font-serif text-xl font-bold text-olive shrink-0 shadow-xs">
          THC
        </div>
        <div class="space-y-1.5 text-center sm:text-left">
          <h4 class="font-serif font-semibold text-xl text-ink-deep">
            {author}
          </h4>
          <p class="text-xs uppercase tracking-wider text-warmBrown font-medium">
            {authorRole} &bull; The House Chapter
          </p>
          <p class="text-xs sm:text-sm text-ink-light leading-relaxed pt-1">
            {siteConfig.defaultAuthor.bio}
          </p>
        </div>
      </div>

      <!-- Category CTA -->
      <div class="my-10 p-6 bg-ivory-dark border-l-2 border-olive flex flex-col sm:flex-row items-center justify-between gap-4 not-prose">
        <div>
          <span class="text-xs uppercase tracking-widest text-warmBrown-light font-semibold block mb-1">
            Explore More In
          </span>
          <h4 class="font-serif text-xl font-semibold text-ink-deep">
            {categoryInfo.name}
          </h4>
        </div>
        <a
          href={`/${category}/`}
          class="px-5 py-2.5 bg-olive hover:bg-olive-dark text-ivory text-xs uppercase tracking-widest font-semibold transition-colors shrink-0 shadow-sm"
        >
          View All {categoryInfo.name} Ideas
        </a>
      </div>

      <!-- Newsletter Invitation -->
      <NewsletterSignup
        variant="boxed"
        headline="A little inspiration for your next chapter at home."
        description="Receive curated decorating dispatches, practical hallway storage blueprints, and quiet design moments delivered straight to your inbox."
      />
    </div>

    <!-- Related Articles Engine Grid (Wide editorial section) -->
    {relatedArticles.length > 0 && (
      <section class="mt-16 pt-12 border-t border-editorial max-w-wide mx-auto">
        <div class="flex items-end justify-between mb-8 pb-3 border-b border-editorial-subtle">
          <div>
            <span class="text-xs uppercase tracking-[0.14em] text-warmBrown-light font-semibold block mb-1">
              Continue Reading
            </span>
            <h3 class="font-serif text-2xl sm:text-3xl font-semibold text-ink-deep">
              Related Chapters
            </h3>
          </div>
          <a
            href={`/${category}/`}
            class="text-xs uppercase tracking-wider text-olive hover:text-ink-deep font-semibold underline underline-offset-4 hidden sm:block"
          >
            Explore {categoryInfo.name} &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
          {relatedArticles.map((rel) => (
            <ArticleCard article={rel} aspectRatio="landscape" />
          ))}
        </div>
      </section>
    )}

  </article>
</BaseLayout>

<style>
  .article-masthead-meta { display: flex; align-items: center; gap: .75rem; max-width: 38rem; margin-top: 1.5rem; padding-top: 1.15rem; border-top: 1px solid rgba(250,247,242,.2); color: rgba(250,247,242,.8); font-size: .7rem; }
  .article-masthead-avatar { display: inline-flex; width: 2.35rem; height: 2.35rem; flex: 0 0 auto; align-items: center; justify-content: center; border: 1px solid rgba(250,247,242,.32); border-radius: 50%; color: #faf7f2; font-family: var(--font-serif); font-size: 1rem; }
  .article-masthead-meta strong, .article-masthead-meta small { display: block; }
  .article-masthead-meta strong { color: #faf7f2; font-size: .75rem; }
  .article-masthead-meta small { margin-top: .15rem; color: rgba(250,247,242,.62); }
  .article-masthead-date { margin-left: auto; text-align: right; }
  @media (max-width: 520px) {
    .article-masthead-meta { align-items: flex-start; flex-wrap: wrap; }
    .article-masthead-date { width: 100%; margin: .35rem 0 0 3.1rem; text-align: left; }
  }
</style>
