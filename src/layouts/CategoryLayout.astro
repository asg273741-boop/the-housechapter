---
import BaseLayout from './BaseLayout.astro';
import EditorialMasthead from '../components/editorial/EditorialMasthead.astro';
import FeaturedHeroCard from '../components/cards/FeaturedHeroCard.astro';
import ArticleCard from '../components/cards/ArticleCard.astro';
import SpecialtyCard from '../components/cards/SpecialtyCard.astro';
import NewsletterSignup from '../components/editorial/NewsletterSignup.astro';
import { siteConfig, type CategoryConfig } from '../config/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  category: CategoryConfig;
  articles: CollectionEntry<'articles'>[];
}

const { category, articles } = Astro.props;
const sortedArticles = [...articles].sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);
const featuredArticle = sortedArticles.find((a) => a.data.featured) || sortedArticles[0];
const remainingArticles = featuredArticle
  ? sortedArticles.filter((a) => a.slug !== featuredArticle.slug)
  : [];

const categoryImages: Record<string, string> = {
  'home-decor': '/images/home/hero-editorial.webp',
  rooms: '/images/home/hero-living-room.jpg',
  'furniture-styling': '/images/home/storage.jpg',
  'organization-storage': '/images/home/kitchen.jpg',
  'small-space-living': '/images/home/apartment.jpg',
  apartments: '/images/home/apartment.jpg',
  'entryways-hallways': '/images/home/entryway.jpg',
  'awkward-spaces': '/images/home/bathroom.jpg',
  'outdoor-garden': '/images/home/outdoor.jpg',
  'seasonal-home': '/images/home/bedroom-editorial.webp',
};
const heroImage = categoryImages[category.slug] || '/images/home/hero-editorial.webp';

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${category.name} | ${siteConfig.siteName}`,
  description: category.editorialDeck,
  url: `${siteConfig.siteUrl}/${category.slug}/`,
  hasPart: sortedArticles.map((art) => ({
    '@type': 'BlogPosting',
    headline: art.data.title,
    url: `${siteConfig.siteUrl}/${art.slug}/`,
  })),
};
---

<BaseLayout
  title={`${category.name} — Decor & Styling Ideas`}
  description={category.shortDescription}
  structuredData={collectionPageSchema}
>
  <EditorialMasthead
    eyebrow={category.isSpecialty ? 'The Signature Chapter' : 'The House Chapter Journal'}
    title={category.name}
    description={category.editorialDeck}
    image={heroImage}
    imageAlt={`${category.name} inspiration from The House Chapter`}
  >
    <div class="editorial-masthead__actions">
      <a class="editorial-masthead__action" href="#chapter-stories">Explore the chapter →</a>
    </div>
  </EditorialMasthead>

  <section class="category-topics" aria-label={`Topics in ${category.name}`}>
    <div class="category-shell">
      <p>Browse by detail</p>
      <div class="category-topics__rail">
        {category.subcategories.map((sub) => (
          <a href={`/search/?q=${encodeURIComponent(sub)}`}>{sub}</a>
        ))}
      </div>
    </div>
  </section>

  <div id="chapter-stories" class="category-shell category-content">
    {featuredArticle ? (
      <section class="category-section">
        <div class="category-heading">
          <div>
            <span>Editor's selection</span>
            <h2>Begin with this story</h2>
          </div>
          <p>Thoughtful, practical, and made for real life.</p>
        </div>
        <FeaturedHeroCard article={featuredArticle} badge={`The ${category.name} Edit`} />
      </section>
    ) : (
      <section class="category-section category-intro-grid">
        <div class="category-heading category-heading--stacked">
          <span>New stories are being prepared</span>
          <h2>A considered guide to {category.name.toLowerCase()}</h2>
          <p>While our editors finish the first features in this chapter, explore the ideas and details shaping the collection.</p>
        </div>
        <div class="topic-card-grid">
          {category.subcategories.slice(0, 6).map((sub, index) => (
            <a href={`/search/?q=${encodeURIComponent(sub)}`} class="topic-card">
              <span>0{index + 1}</span>
              <strong>{sub}</strong>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </div>
      </section>
    )}

    {remainingArticles.length > 0 && (
      <section class="category-section">
        <div class="category-heading">
          <div>
            <span>{category.isSpecialty ? 'Curated portfolio' : 'Latest from the journal'}</span>
            <h2>{category.isSpecialty ? 'Specialty guides & solutions' : `More ${category.name} chapters`}</h2>
          </div>
          <p>{remainingArticles.length} more {remainingArticles.length === 1 ? 'story' : 'stories'} to explore.</p>
        </div>
        <div class="category-card-grid">
          {remainingArticles.map((art, idx) => (
            category.isSpecialty
              ? <SpecialtyCard article={art} index={idx} />
              : <ArticleCard article={art} />
          ))}
        </div>
      </section>
    )}

    <section class="category-philosophy">
      <div>
        <span>The House Chapter approach</span>
        <h2>Beauty that supports the way you live.</h2>
      </div>
      <div>
        <p>We see {category.name.toLowerCase()} as a conversation between architecture and daily ritual—not a chase for passing trends.</p>
        <p>Honest proportions, natural daylight, warm materials, and functional details create rooms that feel calmer now and grow richer with use.</p>
      </div>
    </section>

    <NewsletterSignup variant="boxed" />
  </div>
</BaseLayout>

<style>
  .category-shell { width: min(100% - 2rem, 1360px); margin-inline: auto; }
  .category-topics { border-bottom: 1px solid rgba(35,32,29,.08); background: #faf7f2; }
  .category-topics .category-shell { display: flex; align-items: center; gap: 2rem; padding-block: 1rem; }
  .category-topics p { flex: 0 0 auto; margin: 0; color: #8a6e5e; font-size: .65rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
  .category-topics__rail { display: flex; gap: .65rem; overflow-x: auto; padding: .2rem 0 .55rem; scrollbar-width: thin; scrollbar-color: #737a63 #e7ded1; }
  .category-topics__rail a { flex: 0 0 auto; padding: .55rem .85rem; border: 1px solid rgba(35,32,29,.1); background: #f3ece1; color: #3d3732; font-size: .72rem; transition: background .2s ease, color .2s ease; }
  .category-topics__rail a:hover { background: #3b4734; color: #faf7f2; }
  .category-content { padding-block: clamp(3.5rem, 7vw, 7rem); }
  .category-section + .category-section { margin-top: clamp(4.5rem, 8vw, 8rem); }
  .category-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; border-bottom: 1px solid rgba(35,32,29,.12); padding-bottom: 1rem; }
  .category-heading span, .category-philosophy span { color: #8a6e5e; font-size: .66rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .category-heading h2, .category-philosophy h2 { margin: .35rem 0 0; color: #191614; font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 500; line-height: 1; }
  .category-heading > p { max-width: 24rem; margin: 0; color: #664e40; font-family: var(--font-serif); font-size: 1.05rem; font-style: italic; text-align: right; }
  .category-heading--stacked { display: block; max-width: 50rem; border: 0; }
  .category-heading--stacked p { max-width: 42rem; margin-top: 1rem; font-family: var(--font-sans); font-size: .95rem; font-style: normal; line-height: 1.7; text-align: left; }
  .category-card-grid, .topic-card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .topic-card { display: grid; grid-template-columns: auto 1fr auto; min-height: 8.5rem; align-items: end; gap: 1rem; padding: 1.25rem; border: 1px solid rgba(35,32,29,.09); background: #f3ece1; transition: transform .25s ease, background .25s ease, color .25s ease; }
  .topic-card span { color: #b66348; font-size: .65rem; font-weight: 700; }
  .topic-card strong { font-family: var(--font-serif); font-size: 1.45rem; font-weight: 600; }
  .topic-card i { color: #8a6e5e; font-style: normal; }
  .topic-card:hover { transform: translateY(-3px); background: #3b4734; color: #faf7f2; }
  .category-philosophy { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(2rem, 6vw, 7rem); margin-block: clamp(5rem, 9vw, 9rem); padding: clamp(2.5rem, 6vw, 6rem); background: #303929; color: #faf7f2; }
  .category-philosophy span { color: #decfc0; }
  .category-philosophy h2 { max-width: 12ch; color: #faf7f2; }
  .category-philosophy p { max-width: 42rem; margin: 0; color: rgba(250,247,242,.82); font-size: .98rem; line-height: 1.8; }
  .category-philosophy p + p { margin-top: 1.25rem; }
  @media (max-width: 900px) {
    .category-card-grid, .topic-card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .category-philosophy { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .category-topics .category-shell { display: block; }
    .category-topics p { margin-bottom: .75rem; }
    .category-heading { display: block; }
    .category-heading > p { margin-top: .65rem; text-align: left; }
    .category-card-grid, .topic-card-grid { grid-template-columns: 1fr; }
    .topic-card { min-height: 6.5rem; }
  }
</style>
