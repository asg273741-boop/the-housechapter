---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialMasthead from '../components/editorial/EditorialMasthead.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title={`This Chapter Isn't Here — ${siteConfig.siteName}`}
  description="We could not find the page you were looking for. Let's find another corner of home."
  noindex={true}
>
  <EditorialMasthead
    eyebrow="Error 404"
    title="This chapter isn't here."
    description="The story may have moved or been renamed. Let's find another corner of home."
    image="/images/home/entryway.jpg"
    imageAlt="A welcoming entryway leading into the home"
    compact={true}
  >
    <div class="editorial-masthead__actions">
      <a class="editorial-masthead__action" href="/">Return home →</a>
      <a class="editorial-masthead__action" href="/search/">Search the journal</a>
    </div>
  </EditorialMasthead>

  <section class="max-w-wide mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20 text-center">
    <p class="font-serif italic text-xl text-warmBrown mb-7">Continue with one of our most-read chapters.</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/entryways-hallways/" class="px-5 py-3 bg-parchment hover:bg-olive hover:text-ivory text-ink-deep text-xs uppercase tracking-widest font-semibold border border-editorial transition-colors">Entryways & Hallways</a>
      <a href="/small-space-living/" class="px-5 py-3 bg-parchment hover:bg-olive hover:text-ivory text-ink-deep text-xs uppercase tracking-widest font-semibold border border-editorial transition-colors">Small Spaces</a>
      <a href="/rooms/" class="px-5 py-3 bg-parchment hover:bg-olive hover:text-ivory text-ink-deep text-xs uppercase tracking-widest font-semibold border border-editorial transition-colors">Rooms</a>
      <a href="/home-decor/" class="px-5 py-3 bg-parchment hover:bg-olive hover:text-ivory text-ink-deep text-xs uppercase tracking-widest font-semibold border border-editorial transition-colors">Home Decor</a>
    </div>
  </section>
</BaseLayout>
