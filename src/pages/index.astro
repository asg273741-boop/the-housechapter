---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';

const allArticles = await getCollection('articles');
const sortedArticles = [...allArticles].sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);

const articleOrder = ['apartment-entryway-ideas', 'small-living-room-ideas', 'entryway-storage-ideas'];
const journalArticles = articleOrder
  .map((slug) => sortedArticles.find((article) => article.slug === slug))
  .filter(Boolean);

const journalImageBySlug: Record<string, string> = {
  'apartment-entryway-ideas': '/images/home/apartment.jpg',
  'small-living-room-ideas': '/images/home/hero-living-room.jpg',
  'entryway-storage-ideas': '/images/home/storage.jpg',
};

const roomCards = [
  { label: 'Entryways', href: '/entryways-hallways/', image: '/images/home/entryway.jpg' },
  { label: 'Living Room', href: '/rooms/', image: '/images/home/hero-living-room.jpg' },
  { label: 'Bedroom', href: '/rooms/', image: '/images/home/bedroom-editorial.webp' },
  { label: 'Kitchen', href: '/rooms/', image: '/images/home/kitchen.jpg' },
  { label: 'Bathroom', href: '/rooms/', image: '/images/home/bathroom.jpg' },
  { label: 'Small Spaces', href: '/small-space-living/', image: '/images/home/apartment.jpg' },
  { label: 'Apartments', href: '/apartments/', image: '/images/home/storage.jpg' },
  { label: 'Outdoor & Garden', href: '/outdoor-garden/', image: '/images/home/outdoor.jpg' },
];

const principles = [
  'Real-Home Inspiration',
  'Practical Solutions',
  'Small-Space Friendly',
  'Budget-Conscious Ideas',
  'A Calmer, More Beautiful Life',
];

const philosophyPoints = [
  ['Live With Intention', 'Design choices that support your lifestyle.'],
  ['Find Beauty in the Everyday', 'Simple ideas with a big impact.'],
  ['Create a Home That Grows With You', 'Practical, flexible, and timeless inspiration.'],
];
---

<BaseLayout title={`${siteConfig.siteName} — ${siteConfig.tagline}`} description={siteConfig.description}>
  <section class="home-hero" aria-labelledby="home-hero-title">
    <img class="home-hero__image" src="/images/home/hero-editorial.webp" alt="Warm, light-filled living room with a cream sofa, natural wood and olive accents" loading="eager" fetchpriority="high" />
    <div class="home-hero__shade"></div>
    <div class="home-shell home-hero__content">
      <p class="eyebrow">Home decor ideas for real life</p>
      <h1 id="home-hero-title">Beautiful Homes<br />Start With<br />Thoughtful Details</h1>
      <p class="home-hero__dek">Practical ideas, styling inspiration, and real-home solutions for every corner of your space — no matter the size.</p>
      <a class="primary-button" href="/home-decor/">Explore all ideas <span aria-hidden="true">→</span></a>
      <div class="home-hero__proof" aria-label="Publication highlights">
        <span><strong>1000+</strong>Decor Ideas</span>
        <span><strong>Real Homes</strong>Real Solutions</span>
        <span><strong>A More Intentional</strong>Everyday Life</span>
      </div>
    </div>
    <p class="home-hero__script" aria-hidden="true">Small changes.<br />Big difference.</p>
  </section>

  <section class="home-section home-shell" aria-labelledby="browse-heading">
    <div class="section-heading">
      <div><h2 id="browse-heading">Browse by Space</h2><p>Find inspiration for every corner of your home.</p></div>
      <a href="/rooms/">Explore all rooms <span aria-hidden="true">→</span></a>
    </div>
    <div class="room-grid">
      {roomCards.map((room) => (
        <a class="room-card" href={room.href}>
          <img src={room.image} alt={`${room.label} decorating inspiration`} loading="lazy" />
          <span>{room.label} <b aria-hidden="true">→</b></span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section home-shell journal-section" aria-labelledby="journal-heading">
    <div class="journal-main">
      <div class="section-heading">
        <div><h2 id="journal-heading">Latest From The Journal</h2><p>Fresh ideas, practical guides, and real-home inspiration.</p></div>
        <a href="/search/">View all articles <span aria-hidden="true">→</span></a>
      </div>
      <div class="journal-grid">
        {journalArticles.map((article) => article && (
          <article class="journal-card">
            <a href={`/${article.slug}/`} class="journal-card__image">
              <img src={journalImageBySlug[article.slug] || article.data.heroImage} alt={article.data.heroImageAlt} loading="lazy" />
              <span>{article.data.subcategory}</span>
            </a>
            <h3><a href={`/${article.slug}/`}>{article.data.title}</a></h3>
            <p>{article.data.description}</p>
            <div>
              <time datetime={article.data.publishedAt}>{new Date(article.data.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
              <span>•</span><span>{article.data.readingTime}</span>
            </div>
          </article>
        ))}
      </div>
    </div>

    <aside class="intentional-panel" aria-labelledby="intentional-heading">
      <img src="/images/home/entryway.jpg" alt="Warm interior with a wood console and leafy branches" loading="lazy" />
      <div class="intentional-panel__shade"></div>
      <div class="intentional-panel__content">
        <p class="eyebrow">The House Chapter way</p>
        <h2 id="intentional-heading">Make a More<br />Intentional Home</h2>
        <ul>{principles.map((title) => (<li><span aria-hidden="true">⌂</span>{title}</li>))}</ul>
        <p class="intentional-panel__script">Home should<br />feel like you.</p>
      </div>
    </aside>
  </section>

  <section class="philosophy" aria-labelledby="philosophy-heading">
    <div class="philosophy__story">
      <img src="/images/home/bedroom-editorial.webp" alt="Calm bedroom layered with natural linen and warm wood" loading="lazy" />
      <div class="philosophy__shade"></div>
      <div class="philosophy__copy">
        <p class="eyebrow">The House Chapter philosophy</p>
        <h2 id="philosophy-heading">More Home.<br />More You.</h2>
        <p>We believe a well-lived home isn’t about perfection — it’s about spaces that support your real life. Thoughtful design, meaningful details, and a little everyday beauty can make all the difference.</p>
        <a class="light-button" href="/about/">Our full philosophy <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="philosophy__principles">
      <blockquote>“A home is not a place.<br />It’s a feeling.”</blockquote>
      <div class="philosophy__list">
        {philosophyPoints.map(([title, description], index) => (
          <div><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><p><strong>{title}</strong>{description}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="home-letter" aria-labelledby="newsletter-heading">
    <div class="home-shell home-letter__inner">
      <div><h2 id="newsletter-heading">Join Our Home Letter</h2><p>Get curated decor ideas, new guides, and quiet inspiration delivered to your inbox.</p></div>
      <form action={siteConfig.newsletter.endpoint} method="POST" class="home-letter__form">
        <label class="sr-only" for="home-email">Email address</label>
        <input id="home-email" type="email" name="email" required placeholder="Enter your email address..." />
        <button type="submit">Subscribe</button>
        <small>No spam. No daily noise. Unsubscribe anytime.</small>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  :global(body) { background: #fbf8f2; }
  .home-shell { width: min(100% - 3rem, 1360px); margin-inline: auto; }
  .home-hero { position: relative; min-height: 570px; display: flex; align-items: stretch; overflow: hidden; color: #fffaf2; }
  .home-hero__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 66% center; }
  .home-hero__shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(26,22,18,.93) 0%, rgba(31,26,21,.86) 31%, rgba(31,26,21,.36) 49%, rgba(31,26,21,.04) 72%); }
  .home-hero__content { position: relative; z-index: 2; padding-block: 68px 42px; }
  .eyebrow { margin: 0 0 15px; font-size: .72rem; line-height: 1.3; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
  .home-hero h1 { max-width: 660px; margin: 0; font-family: var(--font-display); font-size: clamp(3.3rem, 5.1vw, 5.6rem); font-weight: 500; line-height: .99; letter-spacing: -.025em; }
  .home-hero__dek { max-width: 520px; margin: 27px 0 29px; font-size: .98rem; line-height: 1.65; color: rgba(255,250,242,.91); }
  .primary-button, .light-button { display: inline-flex; align-items: center; gap: 13px; padding: 15px 24px; background: #596449; color: #fff; font-size: .7rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; transition: transform .2s ease, background .2s ease; }
  .primary-button:hover { background: #697655; transform: translateY(-2px); }
  .home-hero__proof { display: flex; gap: 0; margin-top: 43px; font-size: .7rem; line-height: 1.4; }
  .home-hero__proof span { display: flex; flex-direction: column; min-width: 140px; padding-right: 28px; margin-right: 28px; border-right: 1px solid rgba(255,255,255,.34); }
  .home-hero__proof span:last-child { border: 0; }
  .home-hero__proof strong { font-weight: 600; }
  .home-hero__script { position: absolute; z-index: 2; right: 7%; bottom: 35px; margin: 0; font-family: var(--font-serif); font-size: 1.65rem; font-style: italic; line-height: 1.15; text-align: center; transform: rotate(-7deg); text-shadow: 0 2px 9px rgba(0,0,0,.45); }
  .home-section { padding-block: 55px 36px; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 22px; }
  .section-heading h2 { margin: 0 0 2px; font-family: var(--font-display); font-size: clamp(2rem, 3vw, 2.6rem); font-weight: 500; line-height: 1.15; color: #211d19; }
  .section-heading p { margin: 0; font-size: .77rem; color: #625b54; }
  .section-heading > a { flex: none; padding-bottom: 5px; border-bottom: 1px solid #30362b; color: #25241f; font-size: .64rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .room-grid { display: grid; grid-template-columns: repeat(8, minmax(0,1fr)); gap: 18px; }
  .room-card { color: #312d28; }
  .room-card img { width: 100%; aspect-ratio: .87; object-fit: cover; border-radius: 6px; filter: saturate(.82) contrast(.95); transition: transform .35s ease, filter .35s ease; }
  .room-card span { display: flex; gap: 7px; align-items: center; margin-top: 11px; font-size: .72rem; }
  .room-card b { font-weight: 400; transition: transform .2s ease; }
  .room-card:hover img { transform: translateY(-3px); filter: saturate(1) contrast(1); }
  .room-card:hover b { transform: translateX(3px); }
  .journal-section { display: grid; grid-template-columns: minmax(0, 3fr) minmax(300px, 1fr); gap: 30px; padding-top: 42px; padding-bottom: 52px; }
  .journal-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 27px; }
  .journal-card__image { position: relative; display: block; overflow: hidden; }
  .journal-card__image img { width: 100%; aspect-ratio: 1.42; object-fit: cover; transition: transform .45s ease; }
  .journal-card__image span { position: absolute; left: 0; bottom: 0; padding: 5px 9px; background: rgba(66,66,55,.84); color: #fff; font-size: .55rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .journal-card:hover img { transform: scale(1.025); }
  .journal-card h3 { margin: 15px 0 7px; font-family: var(--font-display); font-size: 1.38rem; font-weight: 500; line-height: 1.08; }
  .journal-card h3 a { color: #211d19; }
  .journal-card > p { margin: 0; color: #625b54; font-size: .7rem; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .journal-card > div:last-child { display: flex; gap: 8px; margin-top: 20px; color: #6d665f; font-size: .55rem; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; }
  .intentional-panel { position: relative; min-height: 485px; overflow: hidden; color: #fff; }
  .intentional-panel > img, .intentional-panel__shade { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .intentional-panel__shade { background: linear-gradient(105deg, rgba(55,56,42,.94), rgba(61,61,45,.72) 60%, rgba(61,61,45,.2)); }
  .intentional-panel__content { position: relative; z-index: 1; height: 100%; padding: 38px 32px; }
  .intentional-panel h2 { margin: 0 0 26px; font-family: var(--font-display); font-size: 1.75rem; font-weight: 500; line-height: 1.15; text-transform: uppercase; letter-spacing: .09em; }
  .intentional-panel ul { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; font-size: .72rem; }
  .intentional-panel li { display: flex; align-items: center; gap: 10px; }
  .intentional-panel li span { display: grid; place-items: center; width: 22px; height: 22px; border: 1px solid rgba(255,255,255,.65); border-radius: 50%; font-size: .68rem; }
  .intentional-panel__script { position: absolute; right: 12px; bottom: 27px; font-family: var(--font-serif); font-size: 1.7rem; font-style: italic; line-height: 1.1; transform: rotate(-7deg); }
  .philosophy { display: grid; grid-template-columns: minmax(0, 2fr) minmax(360px, 1fr); min-height: 500px; }
  .philosophy__story { position: relative; min-height: 500px; overflow: hidden; color: #fff; }
  .philosophy__story > img, .philosophy__shade { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 57%; }
  .philosophy__shade { background: linear-gradient(90deg, rgba(34,28,23,.91), rgba(43,34,27,.65) 52%, rgba(43,34,27,.05)); }
  .philosophy__copy { position: relative; z-index: 1; width: min(660px, 78%); padding: 62px max(6vw, 48px); }
  .philosophy__copy h2 { margin: 0 0 22px; font-family: var(--font-display); font-size: clamp(3.1rem, 4.7vw, 5rem); font-weight: 500; line-height: 1.04; }
  .philosophy__copy > p:not(.eyebrow) { max-width: 560px; margin: 0 0 28px; color: rgba(255,255,255,.9); font-size: .91rem; line-height: 1.6; }
  .light-button { background: #f7f2e8; color: #26231f; }
  .light-button:hover { background: #fff; transform: translateY(-2px); }
  .philosophy__principles { display: flex; flex-direction: column; justify-content: center; padding: 54px 8%; background: #fdfbf7; }
  .philosophy__principles blockquote { margin: 0 auto 44px; color: #3f3a34; font-family: var(--font-serif); font-size: 1.75rem; font-style: italic; line-height: 1.25; text-align: center; }
  .philosophy__list { display: grid; gap: 24px; }
  .philosophy__list > div { display: flex; align-items: center; gap: 15px; }
  .philosophy__list > div > span { display: grid; flex: none; place-items: center; width: 41px; height: 41px; border-radius: 50%; background: #d9d8d3; color: #3a4037; font-family: var(--font-serif); font-weight: 700; }
  .philosophy__list p { display: flex; flex-direction: column; margin: 0; color: #6d655e; font-size: .64rem; line-height: 1.45; }
  .philosophy__list strong { margin-bottom: 2px; color: #28241f; font-family: var(--font-serif); font-size: 1rem; font-weight: 600; }
  .home-letter { position: relative; overflow: hidden; border-bottom: 1px solid rgba(35,32,29,.08); background: linear-gradient(105deg, #f5ede1 0%, #fbf8f2 68%, #e8d8c6 100%); }
  .home-letter::after { content: ''; position: absolute; right: -3%; top: -80%; width: 32%; height: 210%; background: radial-gradient(ellipse, rgba(102,116,76,.16), transparent 63%); transform: rotate(-20deg); }
  .home-letter__inner { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(250px, .8fr) minmax(460px, 1.2fr); align-items: center; gap: 60px; padding-block: 42px; }
  .home-letter h2 { margin: 0 0 5px; font-family: var(--font-display); font-size: 1.8rem; font-weight: 500; }
  .home-letter p { max-width: 420px; margin: 0; color: #615a53; font-size: .72rem; line-height: 1.55; }
  .home-letter__form { display: grid; grid-template-columns: 1fr auto; gap: 8px; }
  .home-letter__form input { min-width: 0; padding: 14px 16px; border: 1px solid rgba(35,32,29,.08); background: #fff; color: #28231f; font-size: .72rem; outline: none; }
  .home-letter__form input:focus { border-color: #596449; box-shadow: 0 0 0 1px #596449; }
  .home-letter__form button { padding: 0 25px; background: #404c38; color: #fff; font-size: .64rem; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
  .home-letter__form small { grid-column: 1 / -1; color: #8a8179; font-size: .53rem; text-align: center; }

  @media (max-width: 1100px) {
    .room-grid { grid-template-columns: repeat(4, minmax(0,1fr)); row-gap: 26px; }
    .journal-section { grid-template-columns: 1fr; }
    .intentional-panel { min-height: 390px; }
    .philosophy { grid-template-columns: 1.4fr 1fr; }
  }
  @media (max-width: 760px) {
    .home-shell { width: min(100% - 2rem, 1360px); }
    .home-hero { min-height: 610px; }
    .home-hero__image { object-position: 65% center; }
    .home-hero__shade { background: linear-gradient(90deg, rgba(24,20,17,.91), rgba(27,23,20,.62)), linear-gradient(0deg, rgba(26,22,18,.75), transparent 50%); }
    .home-hero__content { padding-top: 66px; }
    .home-hero h1 { font-size: clamp(2.7rem, 13vw, 4rem); }
    .home-hero__dek { max-width: 92%; }
    .home-hero__proof { gap: 16px; margin-top: 38px; }
    .home-hero__proof span { min-width: 0; padding-right: 13px; margin-right: 0; font-size: .58rem; }
    .home-hero__script { display: none; }
    .home-section { padding-block: 42px 28px; }
    .section-heading { align-items: start; }
    .section-heading > a { margin-top: 8px; }
    .room-grid { display: flex; margin-right: -1rem; padding-right: 1rem; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; }
    .room-card { flex: 0 0 39%; scroll-snap-align: start; }
    .journal-grid { grid-template-columns: 1fr; gap: 32px; }
    .journal-card__image img { aspect-ratio: 1.6; }
    .intentional-panel { min-height: 430px; }
    .philosophy { grid-template-columns: 1fr; }
    .philosophy__story { min-height: 560px; }
    .philosophy__copy { width: 100%; padding: 62px 32px; }
    .philosophy__principles { padding: 54px 32px; }
    .home-letter__inner { grid-template-columns: 1fr; gap: 22px; }
  }
  @media (max-width: 460px) {
    .section-heading { display: block; }
    .section-heading > a { display: inline-block; margin-top: 12px; }
    .room-card { flex-basis: 47%; }
    .home-letter__form { grid-template-columns: 1fr; }
    .home-letter__form button { min-height: 46px; }
  }
</style>
